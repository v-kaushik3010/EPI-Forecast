# ── API ──────────────────────────────────────────────────────────────────────
# URL of the Flask backend (used by Streamlit dashboard)
BACKEND_URL=http://127.0.0.1:5000

# ── Cache ─────────────────────────────────────────────────────────────────────
# How long to cache fetched data in seconds (default: 1 hour)
CACHE_TTL_SECONDS=3600

# ── Forecasting ───────────────────────────────────────────────────────────────
# Maximum number of days the API will forecast
MAX_FORECAST_DAYS=30

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Flask ─────────────────────────────────────────────────────────────────────
# Port for local development (overridden by Render's $PORT in production)
PORT=5000
